<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_email_server_form">
        <field name="name">fetchmail.server.form</field>
        <field name="model">fetchmail.server</field>
        <field name="inherit_id" ref="mail.view_email_server_form" />
        <field name="arch" type="xml">
            <field name="object_id" position="attributes">
                <attribute
                    name="required"
                >server_type not in ('imap', 'gmail', 'outlook')</attribute>
            </field>
            <xpath expr="//notebook" position="inside">
                <page
                    string="Folders to monitor"
                    invisible="server_type not in ('imap', 'gmail', 'outlook')"
                >
                    <group>
                        <field name="folders_only" />
                    </group>
                    <field name="folder_ids" nolabel="1">
                        <list decoration-muted="active == False">
                            <field name="active" column_invisible="True" />
                            <field name="sequence" widget="handle" />
                            <field name="path" />
                            <field name="archive_path" />
                            <field name="model_id" />
                            <field name="action_id" />
                            <field name="match_algorithm" />
                            <field name="model_field" />
                            <field name="mail_field" />
                            <field name="state" />
                        </list>
                        <form>
                            <field name="state" invisible="1" />
                            <header>
                                <button
                                    type="object"
                                    name="button_confirm_folder"
                                    string="Test &amp; Confirm"
                                    invisible="state != 'draft'"
                                />
                                <button
                                    type="object"
                                    name="button_attach_mail_manually"
                                    string="Attach mail manually"
                                    invisible="state != 'done'"
                                />
                                <button
                                    type="object"
                                    name="fetch_mail"
                                    string="Fetch folder now"
                                    invisible="state != 'done'"
                                />
                                <button
                                    string="Reset Confirmation"
                                    type="object"
                                    name="set_draft"
                                    invisible="state != 'done'"
                                />
                            </header>
                            <group colspan="4" col="2">
                                <!-- Fetch Options -->
                                <group>
                                    <separator string="Fetch Options" />
                                    <field name="active" />
                                    <field name="path" placeholder="INBOX.subfolder1" />
                                    <field name="fetch_unseen_only" />
                                    <field name="fetch_last_day_only" />
                                    <field name="fetch_new_uids_only" />
                                    <field
                                        name="last_uid"
                                        invisible="not fetch_new_uids_only"
                                    />
                                    <field
                                        name="uid_validity"
                                        invisible="not fetch_new_uids_only"
                                    />
                                </group>

                                <!-- Matching Options -->
                                <group>
                                    <separator string="Matching Options" />
                                    <group colspan="2">
                                        <field
                                            name="model_id"
                                            widget="many2one"
                                            options="{'no_create': True}"
                                            nolabel="0"
                                        />
                                        <field name="match_algorithm" />
                                        <field
                                            name="custom_values"
                                            placeholder="{'move_type': 'in_invoice'}"
                                            invisible="match_algorithm != 'odoo_standard'"
                                        />
                                    </group>
                                    <group
                                        invisible="match_algorithm == 'odoo_standard'"
                                        colspan="2"
                                    >
                                        <field
                                            name="model_field"
                                            placeholder="email"
                                            required="match_algorithm in ('email_exact', 'email_domain')"
                                        />
                                        <field
                                            name="mail_field"
                                            placeholder="to,from"
                                            required="match_algorithm in ('email_exact', 'email_domain')"
                                        />
                                        <field
                                            name="domain"
                                            placeholder="[('state', '=', 'open')]"
                                        />
                                        <field name="match_first" />
                                        <field
                                            name="model_order"
                                            placeholder="name asc"
                                            readonly="not match_first"
                                            required="match_first"
                                        />
                                    </group>
                                </group>

                                <!-- Post-Processing Actions -->
                                <group>
                                    <separator string="Model Post-Processing Actions" />
                                    <field name="action_id" />
                                    <field name="msg_state" />
                                </group>

                                <!-- Post-Processing Actions -->
                                <group>
                                    <separator string="Email Post-Processing Actions" />
                                    <field name="seen" />
                                    <field name="archive_path" />
                                    <field name="delete_matching" />
                                    <field name="flag_nonmatching" />
                                </group>
                            </group>
                        </form>
                    </field>
                    <separator string="Folders available on server" colspan="6" />
                    <field name="folders_available" readonly="1" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
